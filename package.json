{
  "name": "sapasense",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "sync-server": "tsx sync-server/dev-server.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:push": "tsx scripts/seed.ts && npx wrangler d1 execute sapasense --remote --file=sync-server/seed.sql --config sync-server/wrangler.toml",
    "deploy:api": "npx wrangler deploy --config sync-server/wrangler.toml",
    "verify:places": "tsx scripts/verify-places.ts"
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.13"
  }
}
